#!/usr/bin/python3
"""Validate the EOS Privet Plasma layout without changing the desktop."""

from __future__ import annotations

import argparse
import json
import math
import re
import sys
from pathlib import Path
from typing import Any


WALLPAPER_URI = (
    "file:///usr/share/wallpapers/EOSPrivet/contents/images/1672x941.png"
)
TOP_APPLETS = [
    "org.kde.plasma.kickoff",
    "org.kde.plasma.panelspacer",
    "org.kde.plasma.systemtray",
    "org.kde.plasma.digitalclock",
]
DOCK_APPLETS = [
    "org.kde.plasma.icontasks",
    "org.kde.plasma.showdesktop",
]
DOCK_LAUNCHERS = ",".join(
    [
        "applications:void-browser.desktop",
        "applications:org.kde.dolphin.desktop",
        "applications:org.kde.konsole.desktop",
        "applications:eos-welcome.desktop",
    ]
)
TOP_HEIGHT_RATIO = 1.9
DOCK_HEIGHT_RATIO = 3.2


MAX_INPUT_BYTES = 8 * 1024 * 1024


class LayoutError(ValueError):
    """Raised when a live or persisted Plasma layout is not the EOS schema."""


def extract_layout(script: str) -> dict[str, Any]:
    if "\r" in script:
        script = script.replace("\r\n", "\n")
        if "\r" in script:
            raise LayoutError("Plasma layout dump contains a bare carriage return")
    prefix = "var plasma = getApiVersion(1);\n\nvar layout = "
    # Plasma 6.3 concatenates QJsonDocument::toJson(QJsonDocument::Indented),
    # which contributes exactly one newline after the closing JSON brace.
    suffix = "\n;\n\nplasma.loadSerializedLayout(layout);"
    if not script.startswith(prefix):
        raise LayoutError("Plasma layout dump has an invalid wrapper")

    def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise LayoutError(f"duplicate JSON key: {key}")
            result[key] = value
        return result

    def reject_constant(value: str) -> None:
        raise LayoutError(f"non-standard JSON constant: {value}")

    decoder = json.JSONDecoder(
        object_pairs_hook=reject_duplicates,
        parse_constant=reject_constant,
    )
    try:
        layout, end = decoder.raw_decode(script, len(prefix))
    except json.JSONDecodeError as error:
        raise LayoutError(f"Plasma layout dump contains invalid JSON: {error}") from error
    remainder = script[end:]
    if not remainder.startswith(suffix) or remainder[len(suffix) :].strip():
        raise LayoutError("Plasma layout dump has an invalid terminator or trailing code")
    if not isinstance(layout, dict):
        raise LayoutError("Plasma layout root is not an object")
    return layout


def validate_live(script: str, *, require_wallpaper: bool = True) -> None:
    layout = extract_layout(script)
    if layout.get("serializationFormatVersion") != "1":
        raise LayoutError("unsupported Plasma layout serialization version")

    desktops = layout.get("desktops")
    if not isinstance(desktops, list) or not desktops:
        raise LayoutError("no active Plasma desktops were serialized")
    for index, desktop in enumerate(desktops):
        if not isinstance(desktop, dict):
            raise LayoutError(f"desktop {index} is not an object")
        if require_wallpaper and desktop.get("wallpaperPlugin") != "org.kde.image":
            raise LayoutError(f"desktop {index} does not use the image wallpaper plugin")
        desktop_config = desktop.get("config")
        wallpaper_config = (
            desktop_config.get("/Wallpaper/org.kde.image/General")
            if isinstance(desktop_config, dict)
            else None
        )
        if require_wallpaper and (
            not isinstance(wallpaper_config, dict)
            or wallpaper_config.get("Image") != WALLPAPER_URI
            or wallpaper_config.get("FillMode") != "2"
        ):
            raise LayoutError(
                f"desktop {index} does not use the exact EOS wallpaper settings"
            )

    panels = layout.get("panels")
    if not isinstance(panels, list) or len(panels) != 2:
        raise LayoutError("the EOS desktop must contain exactly two panels")

    by_location: dict[str, dict[str, Any]] = {}
    for panel in panels:
        if not isinstance(panel, dict):
            raise LayoutError("a serialized panel is not an object")
        location = panel.get("location")
        if location not in {"top", "bottom"} or location in by_location:
            raise LayoutError("the EOS desktop needs one top bar and one bottom dock")
        by_location[location] = panel

    if set(by_location) != {"top", "bottom"}:
        raise LayoutError("the EOS top bar or bottom dock is missing")

    top = by_location["top"]
    if (
        top.get("alignment") != "left"
        or top.get("hiding") != "normal"
    ):
        raise LayoutError("the EOS top bar has the wrong alignment or visibility")
    top_applets = top.get("applets")
    if not isinstance(top_applets, list) or any(
        not isinstance(applet, dict) for applet in top_applets
    ):
        raise LayoutError("the EOS top bar contains an invalid applet record")
    if [applet.get("plugin") for applet in top_applets] != TOP_APPLETS:
        raise LayoutError("the EOS top-bar applets are missing, duplicated, or out of order")
    launcher_config = top_applets[0].get("config")
    launcher_general = (
        launcher_config.get("/General") if isinstance(launcher_config, dict) else None
    )
    if not isinstance(launcher_general, dict) or launcher_general.get("icon") != "eos-privet":
        raise LayoutError("the EOS launcher icon was not saved exactly")

    dock = by_location["bottom"]
    if (
        dock.get("alignment") != "center"
        or dock.get("hiding") != "dodgewindows"
    ):
        raise LayoutError("the EOS dock is not centered and dodge-windows")
    dock_applets = dock.get("applets")
    if not isinstance(dock_applets, list) or any(
        not isinstance(applet, dict) for applet in dock_applets
    ):
        raise LayoutError("the EOS dock contains an invalid applet record")
    if [applet.get("plugin") for applet in dock_applets] != DOCK_APPLETS:
        raise LayoutError("the EOS dock applets are missing, duplicated, or out of order")
    task_config = dock_applets[0].get("config")
    task_general = task_config.get("/General") if isinstance(task_config, dict) else None
    if (
        not isinstance(task_general, dict)
        or task_general.get("launchers") != DOCK_LAUNCHERS
        or task_general.get("showOnlyCurrentActivity") != "true"
        or task_general.get("showOnlyCurrentDesktop") != "false"
    ):
        raise LayoutError("the EOS dock task-manager settings were not saved exactly")

def javascript_round(value: float) -> int:
    """Match JavaScript Math.round for the positive values used by Plasma."""

    return math.floor(value + 0.5)


def parse_kconfig(text: str) -> dict[tuple[str, ...], dict[str, str]]:
    sections: dict[tuple[str, ...], dict[str, str]] = {}
    current: tuple[str, ...] | None = None
    for number, raw_line in enumerate(text.splitlines(), start=1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            parts = tuple(re.findall(r"\[([^]]*)\]", line))
            if not parts or "".join(f"[{part}]" for part in parts) != line:
                raise LayoutError(f"invalid KConfig group on line {number}")
            if any(not part or part.startswith("$") for part in parts):
                raise LayoutError(f"unsupported KConfig group flag on line {number}")
            if parts in sections:
                raise LayoutError(f"duplicate KConfig group on line {number}")
            current = parts
            sections[current] = {}
            continue
        if current is None or "=" not in raw_line:
            raise LayoutError(f"invalid KConfig entry on line {number}")
        key, value = raw_line.split("=", 1)
        key = key.strip()
        if not key or "[$" in key:
            raise LayoutError(f"invalid or immutable KConfig key on line {number}")
        if key in sections[current]:
            raise LayoutError(f"duplicate KConfig key on line {number}")
        sections[current][key] = value.strip()
    return sections


def integer_value(
    entries: dict[str, str], key: str, *, default: int | None = None
) -> int:
    raw_value = entries.get(key)
    if raw_value is None:
        if default is None:
            raise LayoutError(f"persisted Plasma view is missing {key}")
        return default
    if not re.fullmatch(r"0|[1-9][0-9]*", raw_value):
        raise LayoutError(f"persisted Plasma view has an invalid {key}")
    return int(raw_value)


def valid_persisted_thicknesses(top_thickness: int, dock_thickness: int) -> bool:
    return any(
        top_thickness == javascript_round(grid_unit * TOP_HEIGHT_RATIO)
        and dock_thickness == javascript_round(grid_unit * DOCK_HEIGHT_RATIO)
        for grid_unit in range(8, 129, 2)
    )


def validate_config(
    text: str,
    shell_text: str,
    *,
    activity_id: str | None = None,
    expected_desktop_count: int = 1,
) -> None:
    sections = parse_kconfig(text)
    shell_sections = parse_kconfig(shell_text)
    containments: dict[str, dict[str, str]] = {
        group[1]: entries
        for group, entries in sections.items()
        if len(group) == 2 and group[0] == "Containments"
    }
    panel_ids = {
        containment_id
        for containment_id, entries in containments.items()
        if entries.get("plugin") == "org.kde.panel"
    }
    if len(panel_ids) != 2:
        raise LayoutError("persisted Plasma config does not contain exactly two panels")

    for panel_id in panel_ids:
        entries = containments[panel_id]
        if entries.get("formfactor") != "2" or entries.get("location") not in {"3", "4"}:
            raise LayoutError(f"persisted panel {panel_id} has the wrong form factor or location")

    applet_plugins: dict[str, dict[str, str]] = {panel_id: {} for panel_id in panel_ids}
    for group, entries in sections.items():
        if (
            len(group) == 4
            and group[0] == "Containments"
            and group[1] in panel_ids
            and group[2] == "Applets"
        ):
            if not group[3].isdigit():
                raise LayoutError("persisted panel has a non-numeric applet id")
            plugin = entries.get("plugin")
            if not plugin:
                raise LayoutError("persisted panel has an applet without a plugin")
            applet_plugins[group[1]][group[3]] = plugin

    ordered_plugins: dict[str, list[str]] = {}
    ordered_applet_ids: dict[str, list[str]] = {}
    for panel_id in panel_ids:
        general = sections.get(("Containments", panel_id, "General"), {})
        applet_order = general.get("AppletOrder")
        if not applet_order:
            raise LayoutError(f"persisted panel {panel_id} has no AppletOrder")
        applet_ids = applet_order.split(";")
        if (
            any(not applet_id.isdigit() for applet_id in applet_ids)
            or len(applet_ids) != len(set(applet_ids))
            or set(applet_ids) != set(applet_plugins[panel_id])
        ):
            raise LayoutError(f"persisted panel {panel_id} has an invalid AppletOrder")
        ordered_applet_ids[panel_id] = applet_ids
        ordered_plugins[panel_id] = [applet_plugins[panel_id][applet_id] for applet_id in applet_ids]

    top_matches = [
        panel_id
        for panel_id in panel_ids
        if containments[panel_id].get("location") == "3"
        and ordered_plugins[panel_id] == TOP_APPLETS
    ]
    dock_matches = [
        panel_id
        for panel_id in panel_ids
        if containments[panel_id].get("location") == "4"
        and ordered_plugins[panel_id] == DOCK_APPLETS
    ]
    if len(top_matches) != 1 or len(dock_matches) != 1:
        raise LayoutError("persisted Plasma config does not preserve the EOS panel roles and order")

    dock_id = dock_matches[0]
    top_id = top_matches[0]
    launcher_applet_id = ordered_applet_ids[top_id][0]
    launcher_general = sections.get(
        ("Containments", top_id, "Applets", launcher_applet_id, "Configuration", "General"),
        {},
    )
    if launcher_general.get("icon") != "eos-privet":
        raise LayoutError("persisted Plasma config does not preserve the EOS launcher icon")

    task_applet_id = ordered_applet_ids[dock_id][0]
    task_general = sections.get(
        ("Containments", dock_id, "Applets", task_applet_id, "Configuration", "General"),
        {},
    )
    if (
        task_general.get("launchers") != DOCK_LAUNCHERS
        or task_general.get("showOnlyCurrentActivity") != "true"
        or task_general.get("showOnlyCurrentDesktop") != "false"
    ):
        raise LayoutError(
            "persisted Plasma config does not preserve the EOS dock task settings"
        )

    top_view = shell_sections.get(("PlasmaViews", f"Panel {top_id}"), {})
    dock_view = shell_sections.get(("PlasmaViews", f"Panel {dock_id}"), {})
    if (
        integer_value(top_view, "alignment") != 1
        or integer_value(top_view, "panelLengthMode", default=0) != 0
        or integer_value(top_view, "panelVisibility", default=0) != 0
    ):
        raise LayoutError("persisted EOS top-bar view settings are incorrect")
    if (
        integer_value(dock_view, "alignment", default=132) != 132
        or integer_value(dock_view, "panelLengthMode") != 1
        or integer_value(dock_view, "panelVisibility") != 2
    ):
        raise LayoutError("persisted EOS dock view settings are incorrect")

    top_defaults = shell_sections.get(("PlasmaViews", f"Panel {top_id}", "Defaults"), {})
    dock_defaults = shell_sections.get(("PlasmaViews", f"Panel {dock_id}", "Defaults"), {})
    top_thickness = integer_value(top_defaults, "thickness", default=30)
    dock_thickness = integer_value(dock_defaults, "thickness")
    if not valid_persisted_thicknesses(top_thickness, dock_thickness):
        raise LayoutError("persisted EOS panel thicknesses do not match the theme")

    active_desktops = {
        containment_id: entries
        for containment_id, entries in containments.items()
        if entries.get("activityId")
        and containment_id not in panel_ids
        and entries.get("plugin") != "org.kde.plasma.private.systemtray"
    }
    if not active_desktops:
        raise LayoutError("persisted Plasma config has no active desktop containment")
    if activity_id is None:
        current_desktops = active_desktops
    else:
        current_desktops = {
            containment_id: entries
            for containment_id, entries in active_desktops.items()
            if entries.get("activityId") == activity_id
        }
    if len(current_desktops) != expected_desktop_count:
        raise LayoutError(
            "persisted current-activity desktop count differs from the live layout"
        )
    for containment_id, entries in current_desktops.items():
        wallpaper_entries = sections.get(
            ("Containments", containment_id, "Wallpaper", "org.kde.image", "General"),
            {},
        )
        if entries.get("wallpaperplugin") != "org.kde.image":
            raise LayoutError(
                f"persisted current desktop {containment_id} has the wrong wallpaper plugin"
            )
        if (
            wallpaper_entries.get("Image") != WALLPAPER_URI
            or wallpaper_entries.get("FillMode") != "2"
        ):
            raise LayoutError(
                f"persisted current desktop {containment_id} lacks the exact EOS wallpaper"
            )


def compare_live(first: str, second: str) -> None:
    if extract_layout(first) != extract_layout(second):
        raise LayoutError("the restored live Plasma layout differs from its snapshot")


def read_limited(path: Path) -> str:
    raw = path.read_bytes()
    if len(raw) > MAX_INPUT_BYTES:
        raise LayoutError(f"input exceeds {MAX_INPUT_BYTES} bytes: {path}")
    return raw.decode("utf-8")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--live", metavar="FILE", type=Path)
    mode.add_argument("--config", metavar="FILE", type=Path)
    mode.add_argument("--compare-live", metavar=("BEFORE", "AFTER"), nargs=2, type=Path)
    parser.add_argument("--shell-config", metavar="FILE", type=Path)
    parser.add_argument("--live-context", metavar="FILE", type=Path)
    parser.add_argument("--activity-id", metavar="UUID")
    parser.add_argument(
        "--panels-only",
        action="store_true",
        help="validate exact panel structure but allow wallpaper setup to finish",
    )
    args = parser.parse_args()
    try:
        if args.panels_only and not args.live:
            raise LayoutError("--panels-only requires --live")
        config_values = (
            args.config,
            args.shell_config,
            args.live_context,
            args.activity_id,
        )
        if len([value for value in config_values if value]) not in {0, 4}:
            raise LayoutError(
                "--config, --shell-config, --live-context, and --activity-id must be supplied together"
            )
        if args.activity_id and not re.fullmatch(
            r"[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}",
            args.activity_id,
        ):
            raise LayoutError("--activity-id is not a valid KDE activity UUID")
        if args.live:
            validate_live(read_limited(args.live), require_wallpaper=not args.panels_only)
        elif args.config:
            live_context = read_limited(args.live_context)
            validate_live(live_context)
            serialized_desktops = extract_layout(live_context).get("desktops")
            validate_config(
                read_limited(args.config),
                read_limited(args.shell_config),
                activity_id=args.activity_id,
                expected_desktop_count=len(serialized_desktops),
            )
        else:
            compare_live(
                read_limited(args.compare_live[0]),
                read_limited(args.compare_live[1]),
            )
    except (OSError, UnicodeError, LayoutError, RecursionError) as error:
        print(f"EOS Plasma layout verification failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
