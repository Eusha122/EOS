#!/usr/bin/python3
"""Validate the EOS Privet Plasma layout without changing the desktop."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any


WALLPAPER_URI = (
    "file:///usr/share/wallpapers/EOSPrivet/contents/images/1672x941.png"
)
TOP_APPLETS = [
    "org.kde.plasma.kickoff",
    "org.kde.plasma.panelspacer",
    "org.kde.plasma.systemtray",
    "org.kde.plasma.digitalclock",
]
DOCK_APPLETS = [
    "org.kde.plasma.icontasks",
    "org.kde.plasma.showdesktop",
]
DOCK_LAUNCHERS = ",".join(
    [
        "applications:void-browser.desktop",
        "applications:org.kde.dolphin.desktop",
        "applications:org.kde.konsole.desktop",
        "applications:eos-welcome.desktop",
    ]
)


MAX_INPUT_BYTES = 8 * 1024 * 1024


class LayoutError(ValueError):
    """Raised when a live or persisted Plasma layout is not the EOS schema."""


def extract_layout(script: str) -> dict[str, Any]:
    if "\r" in script:
        script = script.replace("\r\n", "\n")
        if "\r" in script:
            raise LayoutError("Plasma layout dump contains a bare carriage return")
    prefix = "var plasma = getApiVersion(1);\n\nvar layout = "
    suffix = ";\n\nplasma.loadSerializedLayout(layout);"
    if not script.startswith(prefix):
        raise LayoutError("Plasma layout dump has an invalid wrapper")

    def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise LayoutError(f"duplicate JSON key: {key}")
            result[key] = value
        return result

    def reject_constant(value: str) -> None:
        raise LayoutError(f"non-standard JSON constant: {value}")

    decoder = json.JSONDecoder(
        object_pairs_hook=reject_duplicates,
        parse_constant=reject_constant,
    )
    try:
        layout, end = decoder.raw_decode(script, len(prefix))
    except json.JSONDecodeError as error:
        raise LayoutError(f"Plasma layout dump contains invalid JSON: {error}") from error
    remainder = script[end:]
    if not remainder.startswith(suffix) or remainder[len(suffix) :].strip():
        raise LayoutError("Plasma layout dump has an invalid terminator or trailing code")
    if not isinstance(layout, dict):
        raise LayoutError("Plasma layout root is not an object")
    return layout


def validate_live(script: str) -> None:
    layout = extract_layout(script)
    if layout.get("serializationFormatVersion") != "1":
        raise LayoutError("unsupported Plasma layout serialization version")

    desktops = layout.get("desktops")
    if not isinstance(desktops, list) or not desktops:
        raise LayoutError("no active Plasma desktops were serialized")
    for index, desktop in enumerate(desktops):
        if not isinstance(desktop, dict):
            raise LayoutError(f"desktop {index} is not an object")
        if desktop.get("wallpaperPlugin") != "org.kde.image":
            raise LayoutError(f"desktop {index} does not use the image wallpaper plugin")
        desktop_config = desktop.get("config")
        wallpaper_config = (
            desktop_config.get("/Wallpaper/org.kde.image/General")
            if isinstance(desktop_config, dict)
            else None
        )
        if not isinstance(wallpaper_config, dict) or wallpaper_config.get("Image") != WALLPAPER_URI:
            raise LayoutError(f"desktop {index} does not use the EOS wallpaper")

    panels = layout.get("panels")
    if not isinstance(panels, list) or len(panels) != 2:
        raise LayoutError("the EOS desktop must contain exactly two panels")

    by_location: dict[str, dict[str, Any]] = {}
    for panel in panels:
        if not isinstance(panel, dict):
            raise LayoutError("a serialized panel is not an object")
        location = panel.get("location")
        if location not in {"top", "bottom"} or location in by_location:
            raise LayoutError("the EOS desktop needs one top bar and one bottom dock")
        by_location[location] = panel

    if set(by_location) != {"top", "bottom"}:
        raise LayoutError("the EOS top bar or bottom dock is missing")

    top = by_location["top"]
    if top.get("lengthMode") != "fill" or top.get("hiding") != "normal":
        raise LayoutError("the EOS top bar has the wrong length or visibility mode")
    top_plugins = [
        applet.get("plugin")
        for applet in top.get("applets", [])
        if isinstance(applet, dict)
    ]
    if top_plugins != TOP_APPLETS:
        raise LayoutError("the EOS top-bar applets are missing, duplicated, or out of order")

    dock = by_location["bottom"]
    if (
        dock.get("lengthMode") != "fit"
        or dock.get("alignment") != "center"
        or dock.get("hiding") != "dodgewindows"
    ):
        raise LayoutError("the EOS dock is not centered, fit-to-content, and dodge-windows")
    dock_applets = [
        applet
        for applet in dock.get("applets", [])
        if isinstance(applet, dict)
    ]
    if [applet.get("plugin") for applet in dock_applets] != DOCK_APPLETS:
        raise LayoutError("the EOS dock applets are missing, duplicated, or out of order")
    task_config = dock_applets[0].get("config")
    task_general = task_config.get("/General") if isinstance(task_config, dict) else None
    if not isinstance(task_general, dict) or task_general.get("launchers") != DOCK_LAUNCHERS:
        raise LayoutError("the EOS dock launcher list was not saved exactly")


def parse_kconfig(text: str) -> dict[tuple[str, ...], dict[str, str]]:
    sections: dict[tuple[str, ...], dict[str, str]] = {}
    current: tuple[str, ...] | None = None
    for number, raw_line in enumerate(text.splitlines(), start=1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            parts = tuple(re.findall(r"\[([^]]*)\]", line))
            if not parts or "".join(f"[{part}]" for part in parts) != line:
                raise LayoutError(f"invalid KConfig group on line {number}")
            if any(not part or part.startswith("$") for part in parts):
                raise LayoutError(f"unsupported KConfig group flag on line {number}")
            if parts in sections:
                raise LayoutError(f"duplicate KConfig group on line {number}")
            current = parts
            sections[current] = {}
            continue
        if current is None or "=" not in raw_line:
            raise LayoutError(f"invalid KConfig entry on line {number}")
        key, value = raw_line.split("=", 1)
        key = key.strip()
        if not key or "[$" in key:
            raise LayoutError(f"invalid or immutable KConfig key on line {number}")
        if key in sections[current]:
            raise LayoutError(f"duplicate KConfig key on line {number}")
        sections[current][key] = value.strip()
    return sections


def validate_config(text: str) -> None:
    sections = parse_kconfig(text)
    containments: dict[str, dict[str, str]] = {
        group[1]: entries
        for group, entries in sections.items()
        if len(group) == 2 and group[0] == "Containments"
    }
    panel_ids = {
        containment_id
        for containment_id, entries in containments.items()
        if entries.get("plugin") == "org.kde.panel"
    }
    if len(panel_ids) != 2:
        raise LayoutError("persisted Plasma config does not contain exactly two panels")

    for panel_id in panel_ids:
        entries = containments[panel_id]
        if entries.get("formfactor") != "2" or entries.get("location") not in {"3", "4"}:
            raise LayoutError(f"persisted panel {panel_id} has the wrong form factor or location")

    applet_plugins: dict[str, dict[str, str]] = {panel_id: {} for panel_id in panel_ids}
    for group, entries in sections.items():
        if (
            len(group) == 4
            and group[0] == "Containments"
            and group[1] in panel_ids
            and group[2] == "Applets"
        ):
            if not group[3].isdigit():
                raise LayoutError("persisted panel has a non-numeric applet id")
            plugin = entries.get("plugin")
            if plugin:
                applet_plugins[group[1]][group[3]] = plugin

    ordered_plugins: dict[str, list[str]] = {}
    ordered_applet_ids: dict[str, list[str]] = {}
    for panel_id in panel_ids:
        general = sections.get(("Containments", panel_id, "General"), {})
        applet_order = general.get("AppletOrder")
        if not applet_order:
            raise LayoutError(f"persisted panel {panel_id} has no AppletOrder")
        applet_ids = applet_order.split(";")
        if (
            any(not applet_id.isdigit() for applet_id in applet_ids)
            or len(applet_ids) != len(set(applet_ids))
            or set(applet_ids) != set(applet_plugins[panel_id])
        ):
            raise LayoutError(f"persisted panel {panel_id} has an invalid AppletOrder")
        ordered_applet_ids[panel_id] = applet_ids
        ordered_plugins[panel_id] = [applet_plugins[panel_id][applet_id] for applet_id in applet_ids]

    top_matches = [
        panel_id
        for panel_id in panel_ids
        if containments[panel_id].get("location") == "3"
        and ordered_plugins[panel_id] == TOP_APPLETS
    ]
    dock_matches = [
        panel_id
        for panel_id in panel_ids
        if containments[panel_id].get("location") == "4"
        and ordered_plugins[panel_id] == DOCK_APPLETS
    ]
    if len(top_matches) != 1 or len(dock_matches) != 1:
        raise LayoutError("persisted Plasma config does not preserve the EOS panel roles and order")

    dock_id = dock_matches[0]
    task_applet_id = ordered_applet_ids[dock_id][0]
    task_general = sections.get(
        ("Containments", dock_id, "Applets", task_applet_id, "Configuration", "General"),
        {},
    )
    if task_general.get("launchers") != DOCK_LAUNCHERS:
        raise LayoutError("persisted Plasma config does not preserve the EOS dock launchers")

    active_desktops = {
        containment_id: entries
        for containment_id, entries in containments.items()
        if entries.get("activityId")
        and containment_id not in panel_ids
        and entries.get("plugin") != "org.kde.plasma.private.systemtray"
    }
    if not active_desktops:
        raise LayoutError("persisted Plasma config has no active desktop containment")
    for containment_id, entries in active_desktops.items():
        if entries.get("wallpaperplugin") != "org.kde.image":
            raise LayoutError(
                f"persisted desktop {containment_id} does not use the image wallpaper plugin"
            )
        wallpaper_entries = sections.get(
            ("Containments", containment_id, "Wallpaper", "org.kde.image", "General"),
            {},
        )
        if wallpaper_entries.get("Image") != WALLPAPER_URI:
            raise LayoutError(f"persisted desktop {containment_id} lacks the EOS wallpaper")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--live", metavar="FILE", type=Path)
    mode.add_argument("--config", metavar="FILE", type=Path)
    args = parser.parse_args()
    source = args.live or args.config
    try:
        raw = source.read_bytes()
        if len(raw) > MAX_INPUT_BYTES:
            raise LayoutError(f"input exceeds {MAX_INPUT_BYTES} bytes")
        text = raw.decode("utf-8")
        if args.live:
            validate_live(text)
        else:
            validate_config(text)
    except (OSError, UnicodeError, LayoutError, RecursionError) as error:
        print(f"EOS Plasma layout verification failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
