#!/bin/sh
set -u
umask 077

# Plasma reads the EOS Global Theme before first login. This script is a
# bounded, versioned repair path for incomplete first-session configuration;
# it is not the primary theming mechanism and it never overwrites a later
# persisted user's layout after this schema has been applied successfully.
theme_id=org.eos.privet.desktop
schema_version=phase2d-1
wallpaper=/usr/share/wallpapers/EOSPrivet/contents/images/1672x941.png
wallpaper_uri="file://$wallpaper"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
marker_dir="$config_home/eos-privet"
marker="$marker_dir/desktop-schema"
log_dir="$state_home/eos-privet"
log="$log_dir/desktop-setup.log"
plasma_config="$config_home/plasma-org.kde.plasma.desktop-appletsrc"
layout_snapshot="$log_dir/live-layout.js"
layout_previous="$log_dir/live-layout.previous.js"
layout_backup="$log_dir/plasma-layout.before-$schema_version.conf"

mkdir -p "$marker_dir" "$log_dir"
exec >>"$log" 2>&1

printf '%s\n' 'EOS desktop setup started'
date -u '+%Y-%m-%dT%H:%M:%SZ'

fail() {
  message=$1
  printf 'ERROR: %s\n' "$message"
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title 'EOS Privet desktop error' --error "$message\n\nDetails: $log" &
  fi
  exit 1
}

[ -r "$wallpaper" ] || fail "EOS wallpaper is missing: $wallpaper"
command -v kwriteconfig6 >/dev/null 2>&1 || fail 'kwriteconfig6 is not installed.'
command -v qdbus6 >/dev/null 2>&1 || fail 'qdbus6 is not installed.'
command -v plasma-apply-wallpaperimage >/dev/null 2>&1 || fail 'Plasma wallpaper support is not installed.'

# A current marker means the factory layout already passed live verification.
# Exit before writing user configuration so future encrypted saved sessions can
# customize their desktop without this first-login repair overwriting it.
if [ "${1:-}" != "--repair" ] && [ -r "$marker" ] && \
   [ "$(cat "$marker" 2>/dev/null || true)" = "$schema_version" ]; then
  printf '%s\n' 'EOS desktop schema is already current; preserving user customization.'
  exit 0
fi

# Keep the selected identity explicit in the user's config so Debian's
# desktop-base fallback can never replace it later in the same session.
kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$theme_id" || \
  fail 'Could not save the EOS Global Theme selection.'
kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle Breeze || \
  fail 'Could not save the EOS widget style.'
kwriteconfig6 --file kdeglobals --group General --key BrowserApplication void-browser.desktop || \
  fail 'Could not save Void as the default browser.'
kwriteconfig6 --file kdeglobals --group General --key ColorScheme BreezeDark || \
  fail 'Could not save the EOS color scheme.'
kwriteconfig6 --file kdeglobals --group Icons --key Theme breeze-dark || \
  fail 'Could not save the EOS icon theme.'
kwriteconfig6 --file plasmarc --group Theme --key name breeze-dark || \
  fail 'Could not save the EOS Plasma style.'

capture_live_layout() {
  : > "$layout_snapshot"
  qdbus6 org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell.dumpCurrentLayoutJS > "$layout_snapshot"
}

live_layout_has_eos_panels() {
  [ -s "$layout_snapshot" ] &&
    grep -Fq 'org.kde.plasma.icontasks' "$layout_snapshot" &&
    grep -Fq 'applications:void-browser.desktop' "$layout_snapshot" &&
    grep -Fq 'org.kde.plasma.systemtray' "$layout_snapshot" &&
    grep -Fq '"location": "top"' "$layout_snapshot" &&
    grep -Fq '"location": "bottom"' "$layout_snapshot"
}

live_layout_matches_schema() {
  live_layout_has_eos_panels &&
    grep -Fq "$wallpaper_uri" "$layout_snapshot"
}

live_layout_is_loaded() {
  [ -s "$layout_snapshot" ] &&
    grep -Fq 'var layout = {' "$layout_snapshot" &&
    grep -Fq '"desktops": [' "$layout_snapshot" &&
    grep -Fq '"wallpaperPlugin":' "$layout_snapshot" &&
    grep -Fq '"panels": [' "$layout_snapshot"
}

wait_for_plasma_ready() {
  rm -f "$layout_previous"
  attempt=0
  stable_snapshots=0
  while [ "$attempt" -lt 45 ]; do
    if capture_live_layout && live_layout_is_loaded; then
      if [ -s "$layout_previous" ] && cmp -s "$layout_snapshot" "$layout_previous"; then
        stable_snapshots=$((stable_snapshots + 1))
        [ "$stable_snapshots" -ge 1 ] && return 0
      else
        stable_snapshots=0
        cp "$layout_snapshot" "$layout_previous" || return 1
      fi
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  return 1
}

wait_for_eos_panels() {
  attempt=0
  while [ "$attempt" -lt 45 ]; do
    capture_live_layout && live_layout_has_eos_panels && return 0
    attempt=$((attempt + 1))
    sleep 1
  done
  return 1
}

wait_for_eos_schema() {
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    capture_live_layout && live_layout_matches_schema && return 0
    attempt=$((attempt + 1))
    sleep 1
  done
  return 1
}

# XDG autostart phase 2 normally runs after plasmashell. A bounded readiness
# check handles slower VM graphics and real hardware without one guessed delay.
wait_for_plasma_ready || fail 'Plasma did not become ready within 45 seconds.'

if ! live_layout_matches_schema; then
  printf '%s\n' 'Applying the EOS Global Theme layout through Plasma.'
  if [ -r "$plasma_config" ]; then
    cp -p "$plasma_config" "$layout_backup" || \
      fail 'Could not back up the previous Plasma layout before repair.'
  fi

  # This is Plasma's supported reset path for a Global Theme. It validates the
  # package, clears the old containment config, and reloads the theme layout in
  # Plasma's event loop instead of injecting JavaScript into a half-loaded UI.
  qdbus6 org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell.loadLookAndFeelDefaultLayout "$theme_id" || \
    fail 'Plasma rejected the EOS Global Theme layout.'

  wait_for_eos_panels || \
    fail 'Plasma did not load the EOS top bar and dock within 45 seconds.'

  plasma-apply-wallpaperimage "$wallpaper" || \
    fail 'Plasma could not apply the EOS wallpaper.'
fi

wait_for_eos_schema || \
  fail 'EOS live desktop verification failed after applying the Global Theme.'

printf '%s\n' "$schema_version" > "$marker" || \
  fail 'Could not record the verified EOS desktop schema.'
printf '%s\n' 'EOS desktop setup verified successfully.'
