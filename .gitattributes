* text=auto

# Linux build inputs must keep Unix line endings when edited on Windows.
*.sh text eol=lf
*.hook.chroot text eol=lf
*.list.chroot text eol=lf
*.desktop text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.js text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
build/live-build-config/includes.chroot/usr/local/bin/* text eol=lf
build/live-build-config/includes.chroot/usr/local/lib/eos-privet/* text eol=lf
build/live-build-config/includes.chroot/usr/lib/os-release text eol=lf

# Image assets must never be line-ending normalized.
*.png binary
